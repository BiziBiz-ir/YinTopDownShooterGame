extends Node
## Autoloaded as `Sfx`. Small pool of players so shots and blasts can overlap.
## Sounds are generated by tools/gen_sfx.py.

const POOL_SIZE := 12

const STREAMS := {
	&"handgun": preload("res://assets/sfx/handgun.wav"),
	&"pistol": preload("res://assets/sfx/pistol.wav"),
	&"smg": preload("res://assets/sfx/smg.wav"),
	&"rifle": preload("res://assets/sfx/rifle.wav"),
	&"shotgun": preload("res://assets/sfx/shotgun.wav"),
	&"explosion": preload("res://assets/sfx/explosion.wav"),
	&"hurt": preload("res://assets/sfx/hurt.wav"),
	&"death": preload("res://assets/sfx/death.wav"),
	&"select": preload("res://assets/sfx/select.wav"),
}

var _players: Array[AudioStreamPlayer] = []
var _next := 0


func _ready() -> void:
	for i in POOL_SIZE:
		var player := AudioStreamPlayer.new()
		add_child(player)
		_players.append(player)


func play(sound: StringName, volume_db: float = 0.0, pitch_variation: float = 0.05) -> void:
	var stream: AudioStream = STREAMS.get(sound)
	if stream == null:
		push_warning("Sfx: unknown sound '%s'" % sound)
		return

	var player := _players[_next]
	_next = (_next + 1) % _players.size()
	player.stream = stream
	player.volume_db = volume_db
	player.pitch_scale = 1.0 + randf_range(-pitch_variation, pitch_variation)
	player.play()
